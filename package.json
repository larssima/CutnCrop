{
  "name": "cutncrop",
  "productName": "CutnCrop",
  "version": "0.1.0",
  "description": "Desktop video editor for Windows",
  "license": "GPL-3.0-or-later",
  "repository": "github:larssima/CutnCrop",
  "author": "Lars Sima",
  "type": "module",
  "main": "src/main/main.js",
  "scripts": {
    "start": "node scripts/start.js",
    "drive-ui": "node scripts/drive-ui.mjs",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.js\"",
    "test:unit": "node --test \"test/unit/*.test.js\"",
    "test-media": "node scripts/make-test-media.js",
    "vendor-ffmpeg": "node scripts/vendor-ffmpeg.js",
    "dist": "npm run vendor-ffmpeg && electron-builder --win",
    "release:patch": "npm test && npm version patch -m \"Release %s\" && npm run dist",
    "release:minor": "npm test && npm version minor -m \"Release %s\" && npm run dist",
    "release:major": "npm test && npm version major -m \"Release %s\" && npm run dist"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "playwright-core": "^1.63.0"
  },
  "build": {
    "appId": "com.cutncrop.app",
    "productName": "CutnCrop",
    "copyright": "Copyright © 2026 Lars Sima. GPL-3.0-or-later.",
    "directories": {
      "output": "dist/${version}",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "vendor/ffmpeg",
        "to": "ffmpeg"
      },
      {
        "from": "LICENSE",
        "to": "LICENSE"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "build/icon.png",
      "artifactName": "${productName}-${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "license": "LICENSE",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    }
  }
}
